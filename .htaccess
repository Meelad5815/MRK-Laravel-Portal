<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never expose Laravel source, dependencies, configuration, or environment files.
    RewriteRule ^(?:\.env|\.env\..*|composer\.(?:json|lock)|artisan)$ - [F,L]
    RewriteRule ^(?:app|bootstrap|config|database|resources|routes|storage|vendor)(?:/|$) - [F,L]

    # Public assets/front controller.
    RewriteRule ^public(?:/|$) - [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
